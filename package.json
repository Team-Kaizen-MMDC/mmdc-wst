  "scripts": {
    "start": "node backend/server.js",
    "postinstall": "cd backend && npm install",
    "playwright:install": "npx playwright install",
    "server": "python3 -m http.server 8000",
    "fix:html": "node ./scripts/fix-html-usability.js",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:smoke": "npx playwright test smoke-links.spec.ts",
    "test:e2e": "npx playwright test e2e-navigation.spec.ts",
    "test:i18n": "npx playwright test i18n.spec.ts",
    "test:jobs": "npx playwright test jobs.spec.js",
    "test:offcanvas": "npx playwright test offcanvas.spec.ts",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:mobile": "npx playwright test --project=webkit-mobile",
    "test:report": "npx playwright show-report",
    "test:codegen": "npx playwright codegen http://localhost:8000",
    "test:with-server": "(python3 -m http.server 8000 > /tmp/mmdc-wst-http.log 2>&1 &) && SERVER_PID=$! && sleep 0.5 && npx playwright test --config=tests/playwright/playwright.config.js; rc=$?; kill $SERVER_PID 2>/dev/null || true; exit $rc",
    "test:playwright": "npx playwright test",
    "test:playwright:with-server": "(python3 -m http.server 8000 > /tmp/mmdc-wst-http.log 2>&1 &) && SERVER_PID=$! && sleep 0.5 && npx playwright test --config=tests/playwright/playwright.config.js; rc=$?; kill $SERVER_PID 2>/dev/null || true; exit $rc",
    "test:playwright:headed": "npx playwright test --headed",
    "test:playwright:chromium": "npx playwright test --project=chromium",
    "test:accessibility": "node tests/accessibility/runAxe.js",
    "test:keyboard": "npx playwright test keyboard-navigation.spec.js",
    "test:usability": "npm run test:accessibility && npm run test:keyboard",
    "usability:summary": "node .github/workflows/scripts/format-usability-summary.js",
    "build:tailwind": "tailwindcss -i ./assets/css/tailwind_input.css -o ./assets/css/dist.css --minify",
    "watch:tailwind": "tailwindcss -i ./assets/css/tailwind_input.css -o ./assets/css/dist.css --watch"
  }
