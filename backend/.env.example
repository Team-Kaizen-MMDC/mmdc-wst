## Example environment variables for local development
# Do NOT commit actual secrets. Copy this file to `.env` and fill in values.

# Node / server
NODE_ENV=development
PORT=3000

# Preferred: full connection string (MongoDB Atlas SRV)
# Example: mongodb+srv://username:password@cluster0.abcd.mongodb.net/japanssw_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@japansswcluster0.lvia1ct.mongodb.net/japansswdb?retryWrites=true&w=majority

# Optional: provide components instead of full URI (the app can assemble these)
MONGODB_USER=
MONGODB_PASS=
MONGODB_HOST=japansswcluster0.lvia1ct.mongodb.net
MONGODB_DB=japansswdb

# Collection names (used by the minimal backend implementation)
CONTENT_COLLECTION=contents
ABOUT_COLLECTION=about

# Authentication / JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@japanssw.com
FROM_NAME="Japan SSW Platform"

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Optional admin token for quick dev-only protected endpoints (short-lived)
X_ADMIN_TOKEN=changeme-in-dev

# Notes:
# - Keep secrets (passwords, API keys) out of committed files. Copy this file to
#   `.env` and populate values for your development environment.
# - For production, prefer managed secret stores / environment configuration.
