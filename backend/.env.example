# Environment Configuration — Japan SSW Platform API
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
# Default port. Use 3000 to avoid conflicts on macOS where port 5000
# may be claimed by system services (AirPlay/AirTunes). Change as needed.
PORT=3000

# ============================================
# DATABASE (MongoDB Atlas)
# ============================================
# Full MongoDB Atlas connection string
# Get this from MongoDB Atlas Dashboard > Connect > Connect your application
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/japansswdb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@japansswcluster0.lvia1ct.mongodb.net/japansswdb?retryWrites=true&w=majority

# Optional: Individual MongoDB components (if not using full URI)
MONGODB_USER=
MONGODB_PASS=
MONGODB_HOST=japansswcluster0.lvia1ct.mongodb.net
MONGODB_DB=japansswdb

# Collection names
CONTENT_COLLECTION=contents
ABOUT_COLLECTION=about

# Use Mongoose ORM for production API (set to true for Day 1-4 REST APIs with authentication)
# Set to false to use native MongoDB driver (simpler for content-only pages)
USE_MONGOOSE=true

# ============================================
# AUTHENTICATION (JWT)
# ============================================
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ============================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ============================================
# Google OAuth credentials: obtain these from Google Cloud Console -> APIs & Services -> Credentials
# NOTE: Do NOT commit real client IDs or secrets to version control. Copy this file to `.env` and fill the values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The backend's own base URL — used to construct OAuth callback URLs automatically.
# Local development: http://localhost:3000
# Production (Railway): https://mmdc-wst-production.up.railway.app
BASE_URL=http://localhost:3000

# Passport.js OAuth callback URL (GET /auth/google/callback).
# Set this in production to override the BASE_URL fallback.
# Must be registered as an Authorized Redirect URI in Google Cloud Console.
# Local:      http://localhost:3000/auth/google/callback
# Production: https://mmdc-wst-production.up.railway.app/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# google-auth-library callback URL used by the manual OAuth flow (GET /api/v1/auth/google/callback).
# Must also be registered in Google Cloud Console.
# Local:      http://localhost:3000/api/v1/auth/google/callback
# Production: https://mmdc-wst-production.up.railway.app/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Comma-separated list of all redirect URIs registered in Google Cloud Console
# (for reference — used when configuring the OAuth client, not read at runtime).
GOOGLE_REDIRECT_URIS=http://localhost:3000/auth/google/callback,http://localhost:3000/api/v1/auth/google/callback

# ============================================
# SECURITY & RATE LIMITING
# ============================================
# Rate limit window (15 minutes in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend URL for CORS. In production set this to your Railway domain.
# Local:      http://localhost:3000
# Production: https://mmdc-wst-production.up.railway.app
FRONTEND_URL=http://localhost:3000

# ============================================
# FILE UPLOAD (Optional - for future use)
# ============================================
# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760
# Upload directory path
UPLOAD_PATH=./uploads
# S3 bucket for storing user resumes (optional)
RESUME_S3_BUCKET=japanssw-s3-bucket

# ============================================
# EMAIL (SendGrid - Optional for now)
# ============================================
# Get API key from SendGrid dashboard
SENDGRID_API_KEY=
FROM_EMAIL=noreply@japanssw.com
FROM_NAME=Japan SSW Platform

# ============================================
# LOGGING
# ============================================
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# ADMIN (Optional - for development only)
# ============================================
# Quick admin token for development (DO NOT USE IN PRODUCTION)
X_ADMIN_TOKEN=changeme-in-dev

# ============================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================
# For production deployment on Railway:
# 1. Set NODE_ENV=production
# 2. Railway injects PORT automatically — do not hardcode it
# 3. Set BASE_URL to your Railway public domain (e.g. https://mmdc-wst-production.up.railway.app)
# 4. Set GOOGLE_OAUTH_REDIRECT_URI and GOOGLE_REDIRECT_URI to the production callback URLs
# 5. Register both callback URLs in Google Cloud Console -> APIs & Services -> Credentials
# 6. Set FRONTEND_URL to your Railway domain for CORS
# 7. Use a strong JWT_SECRET (32+ random characters)
# 8. Set MONGODB_URI to your Atlas connection string
# 9. Never commit .env with real credentials
# 10. Railway auto-provides RAILWAY_PUBLIC_DOMAIN — the code uses it as a last-resort fallback
#     if BASE_URL is not explicitly set
