# Environment Configuration — Japan SSW Platform API
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
# Default port. Use 3000 to avoid conflicts on macOS where port 5000
# may be claimed by system services (AirPlay/AirTunes). Change as needed.
PORT=3000

# ============================================
# DATABASE (MongoDB Atlas)
# ============================================
# Full MongoDB Atlas connection string
# Get this from MongoDB Atlas Dashboard > Connect > Connect your application
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/japansswdb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@japansswcluster0.lvia1ct.mongodb.net/japansswdb?retryWrites=true&w=majority

# Optional: Individual MongoDB components (if not using full URI)
MONGODB_USER=
MONGODB_PASS=
MONGODB_HOST=japansswcluster0.lvia1ct.mongodb.net
MONGODB_DB=japansswdb

# Collection names
CONTENT_COLLECTION=contents
ABOUT_COLLECTION=about

# Use Mongoose ORM for production API (set to true for Day 1-4 REST APIs with authentication)
# Set to false to use native MongoDB driver (simpler for content-only pages)
USE_MONGOOSE=true

# ============================================
# AUTHENTICATION (JWT)
# ============================================
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-this-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ============================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ============================================
# Google OAuth credentials: obtain these from Google Cloud Console -> APIs & Services -> Credentials
# NOTE: Do NOT commit real client IDs or secrets to version control. Copy this file to `.env` and fill the values.
# Example values shown as empty — replace them in your local `.env`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of authorized redirect URIs. These must exactly match what you register in Google Cloud Console.
# For local development you can use the pages under http://localhost:3000
# Example (keep on a single line, comma-separated):
# http://localhost:3000/pages/signin.html,http://localhost:3000/pages/createAccount.html,http://localhost:3000/pages/employerSignin.html,http://localhost:3000/pages/employerCreateAccount.html
GOOGLE_REDIRECT_URIS=http://localhost:3000/pages/signin.html,http://localhost:3000/pages/createAccount.html,http://localhost:3000/pages/employerSignin.html,http://localhost:3000/pages/employerCreateAccount.html

# ============================================
# SECURITY & RATE LIMITING
# ============================================
# Rate limit window (15 minutes in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000
# Production example: FRONTEND_URL=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# ============================================
# FILE UPLOAD (Optional - for future use)
# ============================================
# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760
# Upload directory path
UPLOAD_PATH=./uploads

# ============================================
# EMAIL (SendGrid - Optional for now)
# ============================================
# Get API key from SendGrid dashboard
SENDGRID_API_KEY=
FROM_EMAIL=noreply@japanssw.com
FROM_NAME=Japan SSW Platform

# ============================================
# LOGGING
# ============================================
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# ADMIN (Optional - for development only)
# ============================================
# Quick admin token for development (DO NOT USE IN PRODUCTION)
X_ADMIN_TOKEN=changeme-in-dev

# ============================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================
# For production deployment:
# 1. Change NODE_ENV to 'production'
# 2. Change PORT to 5000 (or your hosting provider's PORT)
# 3. Use strong JWT_SECRET (32+ random characters)
# 4. Set FRONTEND_URL to your actual domain
# 5. Use environment variables manager (Vercel/Railway/Heroku dashboard)
# 6. Never commit .env file with real values
# 7. Consider using managed secrets (AWS Secrets Manager, etc.)
# 8. Enable HTTPS in production (handled by most hosting providers)
# 9. Review and adjust rate limiting for production traffic
# 10. Set up proper logging and monitoring
