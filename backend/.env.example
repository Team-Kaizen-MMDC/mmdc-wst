## Example environment variables for local development
# Do NOT commit actual secrets. Copy this file to .env and fill in values.

# Preferred: full connection string
MONGODB_URI=mongodb+srv://username:password@japansswcluster0.lvia1ct.mongodb.net/?appName=mmdc-wst

# Or provide components separately (the script will build the URI):
MONGODB_USER=japanssw-rw
MONGODB_PASS=password
MONGODB_HOST=japansswcluster0.lvia1ct.mongodb.net
# Optional values
MONGODB_DB= japansswdb
MONGODB_COLLECTION=about
PORT=3000

# Per-purpose collection names (recommended when using multiple collections)
# CONTENT_COLLECTION: collection that stores general page content (e.g. contents)
# ABOUT_COLLECTION: specific collection name for the about page (optional)
CONTENT_COLLECTION=contents
ABOUT_COLLECTION=about
