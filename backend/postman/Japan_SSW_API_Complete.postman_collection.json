            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{COMPANY_ID}}\",\n  \"title\": \"Manufacturing Engineer - SSW Visa\",\n  \"industry\": \"Manufacturing\",\n  \"summary\": \"Join our innovative manufacturing team and work with cutting-edge technology\",\n  \"responsibilities\": \"Design and improve manufacturing processes, maintain equipment, ensure quality standards\",\n  \"requirements\": \"Experience with industrial equipment, Japanese language N3 or higher\",\n  \"benefits\": \"Competitive salary, health insurance, transportation allowance, housing support\",\n  \"japaneseLevel\": \"N3\",\n  \"compensation\": {\n    \"salaryMin\": 250000,\n    \"salaryMax\": 350000,\n    \"currency\": \"JPY\",\n    \"period\": \"monthly\",\n    \"overtimePay\": true\n  },\n  \"location\": {\n    \"prefecture\": \"Tokyo\",\n    \"city\": \"Shibuya\",\n    \"remote\": false\n  },\n  \"workConditions\": {\n    \"workHours\": \"9:00-18:00\",\n    \"daysOff\": \"2 days per week (Saturday, Sunday)\",\n    \"vacation\": \"10 days paid leave per year\"\n  },\n  \"applicationInfo\": {\n    \"deadline\": \"2026-06-30\",\n    \"startDate\": \"2026-08-01\",\n    \"contactEmail\": \"recruit@company.jp\",\n    \"applicationMethod\": \"Platform\"\n  }\n}"
