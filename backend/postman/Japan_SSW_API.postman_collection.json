{
  "info": {
    "name": "Japan SSW API",
    "_postman_id": "japan-ssw-api-collection",
    "description": "Complete API collection for Japan Specified Skilled Worker (SSW) platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
