              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('bearerToken', json.data.token);",
                  "  console.log('Jobseeker token saved');",
                  "}"
                ],
                "type": "text/javascript"
