        {
          "name": "Get Job by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.job && json.data.job._id) {",
                  "  pm.collectionVariables.set('jobId', json.data.job._id);",
                  "  console.log('jobId saved:', json.data.job._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{companyId}}\",\n  \"title\": \"Quality Inspector\",\n  \"industry\": \"Manufacturing\",\n  \"summary\": \"Inspect outgoing products.\",\n  \"responsibilities\": \"Inspect, document, and report quality findings.\",\n  \"requirements\": \"Attention to detail.\",\n  \"compensation\": {\n    \"salaryMin\": 190000,\n    \"salaryMax\": 230000,\n    \"currency\": \"JPY\",\n    \"period\": \"monthly\"\n  },\n  \"location\": {\n    \"prefecture\": \"Tokyo\",\n    \"city\": \"Chiyoda\",\n    \"remote\": false\n  },\n  \"applicationInfo\": {\n    \"deadline\": \"2026-12-31T00:00:00.000Z\",\n    \"startDate\": \"2027-01-31T00:00:00.000Z\",\n    \"contactEmail\": \"jobs@postman-works.example.com\",\n    \"applicationMethod\": \"Platform\"\n  }\n}"
            },
            "url": "{{baseUrl}}/jobs"
          }
        },
        {
          "name": "Create Job (Admin example - auto-create company)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('companyId') || pm.collectionVariables.get('companyId') === '') {",
                  "  const createCompanyReq = {",
                  "    url: pm.collectionVariables.get('baseUrl') + '/companies',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('adminToken') },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ name: 'Postman Auto Company', description: 'Auto-created by Postman admin example', contact: { email: 'admin@postman-company.example', phone: '+81-90-0000-0000' }, location: { prefecture: 'Tokyo', city: 'Chiyoda' } }) }",
                  "  };",
                  "  pm.sendRequest(createCompanyReq, function (err, res) {",
                  "    if (err) { console.error('Company create failed', err); return; }",
                  "    try {",
                  "      const json = res.json();",
                  "      if (json && json.data && json.data._id) {",
                  "        pm.collectionVariables.set('companyId', json.data._id);",
                  "        console.log('Created companyId', json.data._id);",
                  "      } else if (json && json.data && json.data.company && json.data.company._id) {",
                  "        pm.collectionVariables.set('companyId', json.data.company._id);",
                  "        console.log('Created companyId', json.data.company._id);",
                  "      }",
                  "    } catch (e) { console.error('Failed to parse create company response', e); }",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{companyId}}\",\n  \"title\": \"Admin: Production Supervisor\",\n  \"industry\": \"Manufacturing\",\n  \"summary\": \"Supervise production line and ensure quality.\",\n  \"responsibilities\": \"Oversee team, maintain KPIs.\",\n  \"requirements\": \"Experience in manufacturing supervision.\",\n  \"compensation\": {\n    \"salaryMin\": 250000,\n    \"salaryMax\": 320000,\n    \"currency\": \"JPY\",\n    \"period\": \"monthly\"\n  },\n  \"location\": {\n    \"prefecture\": \"Tokyo\",\n    \"city\": \"Chiyoda\",\n    \"remote\": false\n  },\n  \"japaneseLevel\": \"N4\",\n  \"applicationInfo\": {\n    \"deadline\": \"2026-12-31T00:00:00.000Z\",\n    \"startDate\": \"2027-01-31T00:00:00.000Z\",\n    \"contactEmail\": \"hr@postman-company.example\",\n    \"applicationMethod\": \"Platform\"\n  }\n}"
            },
