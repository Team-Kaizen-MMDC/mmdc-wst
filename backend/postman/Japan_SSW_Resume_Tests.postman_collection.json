        {
          "name": "3 — Delete Resume ✅ Happy Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 — Resume deleted', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('success=true and correct message', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.message).to.equal('Resume deleted successfully');",
                  "});",
                  "",
                  "pm.test('Response data is an empty object', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data).to.deep.equal({});",
                  "});",
                  "",
                  "// Clear the saved resume key — resume no longer exists",
                  "pm.collectionVariables.unset('RESUME_KEY');",
                  "console.log('✓ RESUME_KEY cleared from collection variables');"
                ]
              }
            }
          ],
